# Copy this to `.env.local` and fill in what you have. Nothing here is
# required: every value has a fallback, and the app itself needs none of it —
# these are read only by `npm run data`, which fetches the market numbers at
# build time and commits them. Nothing on a child's device ever talks to a
# data provider.
#
# `.env.local` is gitignored. This file is not, so it can say what the names
# are without ever holding a value.

# Weekly closes from Alpha Vantage, which is official and documented.
#
# Free tier is 25 requests a day and a refresh uses eight. Get one at
# https://www.alphavantage.co/support/#api-key — it takes a minute and needs
# only an email address.
#
# Leave it unset and prices come from Yahoo's chart endpoint instead, which
# works, is undocumented, and can change shape without notice. That is the
# fallback the deploy currently runs on; `check-market-data.mjs` compares every
# settled weekly close against the last commit so a silent change of series
# fails the build rather than shipping. Setting this is still the real fix.
#
# For the scheduled refresh to use it, the same value has to be a repository
# secret of the same name — this file is local only. See
# `.github/workflows/refresh-market-data.yml`.
ALPHAVANTAGE_KEY=

# Who the SEC should contact about the filings fetch.
#
# They ask for a real address in the User-Agent and are within their rights to
# block a request without one. Defaults to the maintainer's.
SEC_USER_AGENT=

# How stale the bundled data may be before `npm test` fails, in days.
#
# Both default from the code — prices from `PRICES_STALE_AFTER_DAYS` in
# `src/lib/companies.ts`, filings at 100 — and are here only so a one-off run
# can be loosened deliberately rather than by editing a gate.
MAX_DATA_AGE_DAYS=
MAX_FUNDAMENTALS_AGE_DAYS=
